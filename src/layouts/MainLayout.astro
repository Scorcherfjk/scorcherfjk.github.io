---
import BaseHead from "./BaseHead.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title: string;
  description?: string;
  imageUrl?: string;
  tags?: string[];
}

const { title, description, imageUrl, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      imageUrl={imageUrl}
      tags={tags}
    />
  </head>
  <body class="min-h-dvh flex flex-col bg-background">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
