---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HobbyCard from "../components/HobbyCard.astro";
import CallToAction from "../components/CallToAction.astro";
import { Icon } from "astro-icon/components";
import { EMAIL, LOCATION, SOCIAL_LINKS } from "../consts";

const hobbies = (await getCollection("hobbies")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);

const quickFacts = [
  { icon: "location", label: "Based in", value: LOCATION },
  { icon: "mail", label: "Email", value: EMAIL, href: `mailto:${EMAIL}` },
  { icon: "briefcase", label: "Currently", value: "Full-Stack Developer at Havas" },
  { icon: "code", label: "Focus", value: "Web, ML & teaching" },
];
---

<MainLayout
  title="About"
  description="Who I am beyond the code — my story, my hobbies, and the skills they've given me."
>
  <PageHeader
    eyebrow="About"
    title="More than a developer"
    description="I'm a full-stack developer and programming teacher who believes the best engineers are curious people — and I practice that curiosity outside the editor too."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-primary">
          The short version
        </h2>
        <div class="mt-5 space-y-5 text-base leading-relaxed text-primary/85">
          <p>
            I started as a self-taught developer and ended up teaching other
            people to code. Somewhere along the way I became a full-stack
            developer at Havas, where I build production web experiences used
            by real audiences every day.
          </p>
          <p>
            My roots are in the fundamentals — JavaScript, Python, databases,
            and how the web actually works. That base lets me pick up anything:
            React, Vue, Swift, Flutter, TensorFlow, or the next tool that
            shows up.
          </p>
          <p>
            But I don't only grow in front of a screen. The hobbies below aren't
            a break from work — they're where I practice discipline, taste and
            systems thinking, and bring those skills back to the job.
          </p>
        </div>
      </div>

      <aside class="h-fit rounded-lg border border-border bg-surface p-6 lg:sticky lg:top-24">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">
          Quick facts
        </p>
        <ul class="mt-5 space-y-5">
          {
            quickFacts.map((fact) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-md bg-surface-alt">
                  <Icon name={fact.icon} class="size-4 text-accent-soft" />
                </span>
                <div>
                  <p class="text-xs text-muted">{fact.label}</p>
                  {
                    fact.href ? (
                      <a
                        href={fact.href}
                        class="text-sm font-medium text-primary transition hover:text-accent"
                      >
                        {fact.value}
                      </a>
                    ) : (
                      <p class="text-sm font-medium text-primary">
                        {fact.value}
                      </p>
                    )
                  }
                </div>
              </li>
            ))
          }
        </ul>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs text-muted">Find me online</p>
          <ul class="mt-3 flex gap-3">
            {
              SOCIAL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.url}
                    rel="noreferrer"
                    target="_blank"
                    aria-label={link.label}
                    class="grid size-9 place-items-center rounded-md border border-border text-muted transition hover:border-accent/60 hover:text-accent"
                  >
                    <Icon name={link.icon} class="size-4" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Beyond the code"
        title="Hobbies that sharpen my craft"
        description="Side projects and hobbies where I learn real, transferable skills — by doing, not just reading."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          hobbies.map((hobby) => (
            <HobbyCard hobby={hobby} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <CallToAction
      title="Want to work together?"
      description="Whether it's a product, a class, or a coffee — I'd love to hear from you."
      primaryText="Email me"
      primaryHref={`mailto:${EMAIL}`}
      secondaryText="See my projects"
      secondaryHref="/projects"
    />
  </section>
</MainLayout>
