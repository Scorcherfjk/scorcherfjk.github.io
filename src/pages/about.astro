---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import HobbyCard from "../components/HobbyCard.astro";
import EducationCard from "../components/EducationCard.astro";
import CallToAction from "../components/CallToAction.astro";
import { Icon } from "astro-icon/components";
import { CV_URL, LANGUAGES, LINKEDIN_URL, LOCATION, SOCIAL_LINKS } from "../consts";

const hobbies = (await getCollection("hobbies")).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);

const education = (await getCollection("education")).sort((a, b) =>
  (b.data.startDate ?? "").localeCompare(a.data.startDate ?? ""),
);

const quickFacts = [
  { icon: "location", label: "Based in", value: LOCATION },
  { icon: "briefcase", label: "Currently", value: "Senior Backend Engineer at Globant" },
  {
    icon: "code",
    label: "Focus",
    value: "Distributed systems & cloud-native",
  },
];
---

<MainLayout
  title="About"
  description="Who I am beyond the code — my story, my hobbies, and the skills they've given me."
>
  <PageHeader
    eyebrow="About"
    title="More than a developer"
    description="I'm a senior backend engineer who believes the best engineers are curious people — and I practice that curiosity outside the editor too."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold tracking-tight text-primary">
          The short version
        </h2>
        <div class="mt-5 space-y-5 text-base leading-relaxed text-primary/85">
          <p>
            I'm a senior backend engineer with 9+ years of experience building
            scalable distributed systems and cloud-native applications. Today
            I work at Globant, delivering enterprise solutions across fintech,
            entertainment, analytics and construction tech.
          </p>
          <p>
            My focus is backend architecture — Node.js, TypeScript and NestJS —
            on top of event-driven systems, microservices and AWS. I've led
            architecture spikes, introduced decision records, migrated critical
            systems with zero downtime, and mentored engineers on SOLID,
            design patterns and Hexagonal Architecture.
          </p>
          <p>
            But I don't only grow in front of a screen. The hobbies below aren't
            a break from work — they're where I practice discipline, taste and
            systems thinking, and bring those skills back to the job.
          </p>
        </div>
      </div>

      <aside class="h-fit rounded-lg border border-border bg-surface p-6 lg:sticky lg:top-24">
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">
          Quick facts
        </p>
        <ul class="mt-5 space-y-5">
          {
            quickFacts.map((fact) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-md bg-surface-alt">
                  <Icon name={fact.icon} class="size-4 text-accent-soft" />
                </span>
                <div>
                  <p class="text-xs text-muted">{fact.label}</p>
                  <p class="text-sm font-medium text-primary">{fact.value}</p>
                </div>
              </li>
            ))
          }
          <li class="flex items-start gap-3">
            <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-md bg-surface-alt">
              <Icon name="linkedin" class="size-4 text-accent-soft" />
            </span>
            <div>
              <p class="text-xs text-muted">Contact</p>
              <a
                href={LINKEDIN_URL}
                target="_blank"
                rel="noreferrer"
                class="text-sm font-medium text-primary transition hover:text-accent"
              >
                Connect on LinkedIn
              </a>
            </div>
          </li>
        </ul>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs text-muted">Languages</p>
          <ul class="mt-3 space-y-2">
            {
              LANGUAGES.map((lang) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="flex items-center gap-2 text-sm font-medium text-primary">
                    <span class="text-base leading-none" aria-hidden="true">
                      {lang.flag}
                    </span>
                    {lang.name}
                  </span>
                  <span class="font-mono text-xs text-muted">{lang.level}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8 border-t border-border pt-6">
          <p class="text-xs text-muted">Find me online</p>
          <ul class="mt-3 flex gap-3">
            {
              SOCIAL_LINKS.map((link) => (
                <li>
                  <a
                    href={link.url}
                    rel="noreferrer"
                    target="_blank"
                    aria-label={link.label}
                    class="grid size-9 place-items-center rounded-md border border-border text-muted transition hover:border-accent/60 hover:text-accent"
                  >
                    <Icon name={link.icon} class="size-4" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Education"
        title="Where it all started"
        description="The degree behind the engineer — formal training in information technology and software engineering."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          education.map((edu) => (
            <EducationCard education={edu} />
          ))
        }
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4 rounded-xl border border-accent/30 bg-gradient-to-br from-surface to-surface-alt p-6 sm:p-8">
        <div class="min-w-0 flex-1">
          <h3 class="text-lg font-bold tracking-tight text-primary">
            Download my resume
          </h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">
            The short version of my career so far, in a single PDF — work
            experience, skills, education and certifications.
          </p>
        </div>
        <a
          href={CV_URL}
          download
          class="inline-flex shrink-0 items-center gap-2 rounded-md bg-accent px-6 py-3 text-sm font-semibold text-background transition hover:bg-accent-soft"
        >
          <Icon name="download" class="size-4" />
          Download CV (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Beyond the code"
        title="Hobbies that sharpen my craft"
        description="Side projects and hobbies where I learn real, transferable skills — by doing, not just reading."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          hobbies.map((hobby) => (
            <HobbyCard hobby={hobby} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <CallToAction
      title="Want to work together?"
      description="Whether it's a product, a class, or a coffee — send me a message on LinkedIn."
      primaryText="Connect on LinkedIn"
      primaryHref={LINKEDIN_URL}
      primaryExternal
      secondaryText="See my projects"
      secondaryHref="/projects"
    />
  </section>
</MainLayout>
