---
import MainLayout from "../layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";

const title = "Page not found";
---

<MainLayout title={title} description="The page you're looking for doesn't exist.">
  <section class="mx-auto flex min-h-[60dvh] max-w-2xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6">
    <span class="grid size-16 place-items-center rounded-xl border border-border bg-surface">
      <Icon name="code" class="size-8 text-accent-soft" />
    </span>
    <p class="mt-8 font-mono text-xs uppercase tracking-widest text-accent">
      404 error
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-primary sm:text-5xl">
      Page not found
    </h1>
    <p class="mt-4 max-w-md text-muted">
      The page you're looking for doesn't exist, was moved, or is still being
      built.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 text-sm font-semibold text-background transition hover:bg-accent-soft"
    >
      Back to home
      <Icon name="arrow-right" class="size-4" />
    </a>
  </section>
</MainLayout>
