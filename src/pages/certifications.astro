---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CertificationCard from "../components/CertificationCard.astro";
import CourseCard from "../components/CourseCard.astro";
import CallToAction from "../components/CallToAction.astro";

const certifications = (await getCollection("certifications")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const categories = [
  ...new Set(certifications.map((cert) => cert.data.category)),
];

const courses = (await getCollection("courses")).sort((a, b) => {
  const typeDiff =
    (a.data.type === "Specialization" ? 0 : 1) -
    (b.data.type === "Specialization" ? 0 : 1);
  if (typeDiff !== 0) return typeDiff;
  return (b.data.date ?? "").localeCompare(a.data.date ?? "");
});
---

<MainLayout
  title="Certifications"
  description="Training and certifications I've earned — every certificate is available as a PDF."
>
  <PageHeader
    eyebrow="Credentials"
    title="Certifications"
    description="Certifications, courses and specializations I've completed — certificates open as PDFs and courses link to their credentials."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <ul class="mb-10 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <li>
            <span class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted">
              {category}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert) => (
          <CertificationCard cert={cert} />
        ))
      }
    </div>
  </section>

  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Learning"
        title="Courses & Specializations"
        description="Specializations and courses I've completed to stay sharp — in cloud engineering, AI fundamentals and applied LLM development."
      />

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          courses.map((course) => (
            <CourseCard course={course} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <CallToAction
      title="Always learning"
      description="I'm currently working on my next certification. Check back soon, or get in touch if you want to talk shop."
      primaryText="Get in touch"
      primaryHref="/about"
    />
  </section>
</MainLayout>
