---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import CertificationCard from "../components/CertificationCard.astro";
import CallToAction from "../components/CallToAction.astro";

const certifications = (await getCollection("certifications")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);

const categories = [
  ...new Set(certifications.map((cert) => cert.data.category)),
];
---

<MainLayout
  title="Certifications"
  description="Training and certifications I've earned — every certificate is available as a PDF."
>
  <PageHeader
    eyebrow="Credentials"
    title="Certifications"
    description="Courses and certifications I've completed. Every one opens its certificate as a PDF in a new tab."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <ul class="mb-10 flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <li>
            <span class="inline-flex items-center rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted">
              {category}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert) => (
          <CertificationCard cert={cert} />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
    <CallToAction
      title="Always learning"
      description="I'm currently working on my next certification. Check back soon, or get in touch if you want to talk shop."
      primaryText="Get in touch"
      primaryHref="/about"
    />
  </section>
</MainLayout>
