---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    {
      eyebrow && (
        <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">
          {eyebrow}
        </p>
      )
    }
    <h1
      class="mt-3 text-4xl font-bold tracking-tight text-primary sm:text-5xl"
    >
      {title}
    </h1>
    {
      description && (
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          {description}
        </p>
      )
    }
    <slot />
  </div>
</section>
