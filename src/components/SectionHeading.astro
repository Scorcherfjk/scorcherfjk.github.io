---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  centered?: boolean;
}

const { eyebrow, title, description, centered = false } = Astro.props;
---

<div class={centered ? "mx-auto max-w-2xl text-center" : "max-w-2xl"}>
  {
    eyebrow && (
      <p class="font-mono text-xs font-semibold uppercase tracking-widest text-accent">
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-primary sm:text-4xl">
    {title}
  </h2>
  {
    description && (
      <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
        {description}
      </p>
    )
  }
</div>
