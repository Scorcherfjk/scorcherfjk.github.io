---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Badge from "./Badge.astro";
import { formatMonthYear } from "../utils";

interface Props {
  course: CollectionEntry<"courses">;
}

const { course } = Astro.props;
const { data } = course;

const isSpecialization = data.type === "Specialization";

const action = data.credentialUrl
  ? { href: data.credentialUrl, label: "Verify" }
  : data.pdf
    ? { href: data.pdf, label: "View certificate" }
    : null;
---

{
  isSpecialization ? (
    <article class="flex flex-col rounded-lg border border-border bg-surface p-6 transition hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg hover:shadow-black/10">
      <div class="flex items-start justify-between gap-3">
        <span class="grid size-10 place-items-center rounded-md bg-surface-alt">
          <Icon name="server" class="size-5 text-accent-soft" />
        </span>
        <span
          class="rounded-full border border-border bg-surface-alt px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-accent"
        >
          {data.type}
        </span>
      </div>

      <h3 class="mt-4 text-lg font-bold tracking-tight text-primary">
        {data.title}
      </h3>
      <p class="mt-0.5 text-sm font-medium text-accent">{data.provider}</p>

      {
        data.date && (
          <p class="mt-1.5 font-mono text-xs text-muted">
            {formatMonthYear(data.date)}
          </p>
        )
      }

      {
        data.skills && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {data.skills.map((skill) => (
              <li>
                <Badge text={skill} />
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-6 flex flex-1 flex-wrap items-end gap-3 text-sm">
        {
          action && (
            <a
              href={action.href}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 font-semibold text-background transition hover:bg-accent-soft"
            >
              {action.label}
              <Icon name="external-link" class="size-4" />
            </a>
          )
        }
      </div>
    </article>
  ) : (
    <article class="flex flex-col rounded-lg border border-border bg-surface p-4 transition hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg hover:shadow-black/10">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-base font-semibold tracking-tight text-primary">
          {data.title}
        </h3>
        <span class="shrink-0 rounded-full border border-border bg-surface-alt px-2 py-0.5 font-mono text-[9px] font-semibold uppercase tracking-wider text-accent">
          {data.type}
        </span>
      </div>

      <p class="mt-0.5 text-sm font-medium text-accent">{data.provider}</p>

      {
        data.date && (
          <p class="mt-1 font-mono text-xs text-muted">
            {formatMonthYear(data.date)}
          </p>
        )
      }

      {
        data.skills && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {data.skills.slice(0, 3).map((skill) => (
              <li>
                <Badge text={skill} />
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-4 flex flex-1 flex-wrap items-end gap-4 text-sm">
        {
          action && (
            <a
              href={action.href}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center gap-1.5 font-semibold text-accent transition hover:text-accent-soft"
            >
              {action.label}
              <Icon name="external-link" class="size-4" />
            </a>
          )
        }
      </div>
    </article>
  )
}
