---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
  hobby: CollectionEntry<"hobbies">;
}

const { hobby } = Astro.props;
const { data } = hobby;
---

<article
  class="flex flex-col rounded-lg border border-border bg-surface p-6 transition hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg hover:shadow-black/10"
>
  <div class="flex items-center gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-md bg-surface-alt">
      <Icon name={data.icon ?? "code"} class="size-6 text-accent-soft" />
    </span>
    <div class="min-w-0">
      <h3 class="flex items-center gap-2 text-lg font-bold tracking-tight text-primary">
        {data.name}
        {
          data.featured && (
            <span class="rounded-full border border-accent/40 bg-accent/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-accent">
              Featured
            </span>
          )
        }
      </h3>
      <p class="truncate text-sm text-muted">{data.tagline}</p>
    </div>
  </div>

  <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">
    {data.description}
  </p>

  <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-muted">
    Skills gained
  </p>
  <ul class="mt-3 list-none space-y-2">
    {
      data.skills.map((skill) => (
        <li class="flex gap-3 text-sm text-primary/80">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" />
          {skill}
        </li>
      ))
    }
  </ul>

  {
    data.links && data.links.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-4 text-sm">
        {data.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-1.5 font-medium text-accent transition hover:text-accent-soft"
          >
            <Icon name="external-link" class="size-4" />
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>
