---
import { Icon } from "astro-icon/components";
import { CV_URL, LOCATION, ROLE, SOCIAL_LINKS } from "../consts";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
  >
    <div
      class="absolute -top-40 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full bg-accent/10 blur-3xl"
    />
  </div>

  <div
    class="relative mx-auto grid max-w-6xl gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-28"
  >
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-accent">
        {LOCATION}
      </p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-primary sm:text-6xl">
        {title}
      </h1>
      <p class="mt-3 text-xl font-medium text-accent-soft sm:text-2xl">
        {ROLE}
      </p>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        {description}
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 rounded-md bg-accent px-6 py-3 text-sm font-semibold text-background transition hover:bg-accent-soft"
        >
          View my work
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a
          href="/about"
          class="inline-flex items-center gap-2 rounded-md border border-border bg-surface px-6 py-3 text-sm font-semibold text-primary transition hover:border-accent/60 hover:text-accent"
        >
          More about me
        </a>
        <a
          href={CV_URL}
          download
          class="inline-flex items-center gap-2 rounded-md border border-border bg-surface px-6 py-3 text-sm font-semibold text-muted transition hover:border-accent/60 hover:text-accent"
        >
          <Icon name="download" class="size-4" />
          Download CV
        </a>
      </div>

      <ul class="mt-10 flex gap-3">
        {
          SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.url}
                rel="noreferrer"
                target={link.url.startsWith("http") ? "_blank" : undefined}
                aria-label={link.label}
                class="grid size-10 place-items-center rounded-md border border-border bg-surface text-muted transition hover:border-accent/60 hover:text-accent"
              >
                <Icon name={link.icon} class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="hidden overflow-hidden rounded-lg border border-border bg-surface shadow-xl shadow-black/20 lg:block"
      aria-hidden="true"
    >
      <div class="flex items-center gap-1.5 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-red-500/70" />
        <span class="size-3 rounded-full bg-yellow-500/70" />
        <span class="size-3 rounded-full bg-green-500/70" />
        <span class="ml-3 font-mono text-xs text-muted">developer.js</span>
      </div>
      <pre class="overflow-x-auto p-6 font-mono text-sm leading-7">
<code><span class="text-fuchsia-400">const</span> <span class="text-primary">developer</span> <span class="text-muted">=</span> <span class="text-fuchsia-400">&#123;</span>
  <span class="text-cyan-400">name</span><span class="text-muted">:</span> <span class="text-lime-400">"Francisco J. De Freitas"</span><span class="text-muted">,</span>
  <span class="text-cyan-400">role</span><span class="text-muted">:</span> <span class="text-lime-400">"Senior Backend Engineer"</span><span class="text-muted">,</span>
  <span class="text-cyan-400">architecture</span><span class="text-muted">:</span> <span class="text-lime-400">"Event-Driven · Hexagonal"</span><span class="text-muted">,</span>
  <span class="text-cyan-400">stack</span><span class="text-muted">:</span> <span class="text-fuchsia-400">[</span>
    <span class="text-lime-400">"NestJS"</span><span class="text-muted">,</span> <span class="text-lime-400">"Node.js"</span><span class="text-muted">,</span> <span class="text-lime-400">"TypeScript"</span><span class="text-muted">,</span>
    <span class="text-lime-400">"AWS"</span><span class="text-muted">,</span> <span class="text-lime-400">"Kafka"</span><span class="text-muted">,</span> <span class="text-lime-400">"Docker"</span><span class="text-muted">,</span>
  <span class="text-fuchsia-400">]</span><span class="text-muted">,</span>
  <span class="text-cyan-400">openToWork</span><span class="text-muted">:</span> <span class="text-lime-400">true</span><span class="text-muted">,</span>
<span class="text-fuchsia-400">&#125;</span><span class="text-muted">;</span></code>
      </pre>
    </div>
  </div>
</section>
